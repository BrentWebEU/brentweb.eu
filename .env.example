# Google Analytics 4 Measurement ID
# Get your GA4 ID from: https://analytics.google.com/
NEXT_PUBLIC_GA_ID=G-NTBEEGE8WJ

# Google Maps API Key
# Get your API key from: https://console.cloud.google.com/google/maps-apis
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Resend (lead notification + confirmation emails from the contact form and calculator)
# Get your API key from: https://resend.com/api-keys
# Requires the brentweb.eu sending domain to be verified in Resend (SPF/DKIM/DMARC) before real mail sends.
RESEND_API_KEY=re_your_resend_api_key_here
